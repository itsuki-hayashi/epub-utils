with "xmlada_sax";
with "zipada";
with "core_containers.gpr";
with "platform.gpr";
with "build_options.gpr";

project Epub_V2h_Ada is
   case Platform.Target is
      when "linux" => for Languages use ("Ada", "C");
      when others => for Languages use ("Ada");
   end case;
   for Source_Dirs use ("src", "src/platform/" & Platform.Target,
                        "src/profiling/" & Build_Options.Profiling_Directory);
   for Excluded_Source_Files use ("epub.ads", "epub-lists.ads", "epub-lists.adb");
   for Object_Dir use "obj" & Platform.Build_Suffix;
   case Build_Options.Linked_Output is
      when "true" => for Exec_Dir use "obj" & Platform.Build_Suffix & "/linked";
      when "false" => for Exec_Dir use "bin" & Platform.Build_Suffix;
   end case;
   for Main use ("epub_v2h_main.adb");
   package Builder is
      for Executable ("epub_v2h_main.adb") use "epub-v2h";
   end Builder;
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatw.e", "-gnatwe", "-gnata",
         "-Wall", "-Wextra", "-Werror", "-g") &
         Build_Options.Optimization & Build_Options.Instrumentation & Build_Options.Section_Flags;
      for Default_Switches ("C") use
        ("-std=c17", "-Wall", "-Wextra", "-Werror", "-g") &
        Build_Options.C_Optimization & Build_Options.Section_Flags;
   end Compiler;
   package Binder is
      for Default_Switches ("Ada") use ("-static", "-we");
   end Binder;
   package Linker is
      Profiling_Linker := ();
      Section_Linker := ();
      case Build_Options.Sections is
         when "true" => Section_Linker := ("-Wl,--gc-sections");
         when "false" => null;
      end case;
      case Platform.Target is
         when "windows" =>
            case Build_Options.Gprof is
               when "true" => Profiling_Linker := ("-Wl,--disable-dynamicbase");
               when others => null;
            end case;
         when others => null;
      end case;
      for Default_Switches ("Ada") use
        ("-static", "-static-libgcc", "-Wl,--fatal-warnings",
         "-Wl,-Map=" & external ("EPUB_LINK_MAP", "epub-v2h.map")) & Platform.Native_Libraries &
         Build_Options.Instrumentation & Profiling_Linker & Section_Linker;
   end Linker;
end Epub_V2h_Ada;
