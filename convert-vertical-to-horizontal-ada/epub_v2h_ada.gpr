with "xmlada_sax";
with "zipada";
with "core_containers.gpr";
with "platform.gpr";

project Epub_V2h_Ada is
   case Platform.Target is
      when "linux" => for Languages use ("Ada", "C");
      when others => for Languages use ("Ada");
   end case;
   for Source_Dirs use ("src", "src/platform/" & Platform.Target);
   for Excluded_Source_Files use ("epub.ads", "epub-lists.ads", "epub-lists.adb");
   for Object_Dir use "obj" & Platform.Build_Suffix;
   for Exec_Dir use "bin" & Platform.Build_Suffix;
   for Main use ("epub_v2h_main.adb");
   package Builder is
      for Executable ("epub_v2h_main.adb") use "epub-v2h-ada";
   end Builder;
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatw.e", "-gnatwe", "-gnata",
         "-Wall", "-Wextra", "-Werror", "-g", "-O2");
      for Default_Switches ("C") use
        ("-std=c17", "-Wall", "-Wextra", "-Werror", "-g", "-O2");
   end Compiler;
   package Binder is
      for Default_Switches ("Ada") use ("-static", "-we");
   end Binder;
   package Linker is
      for Default_Switches ("Ada") use
        ("-static", "-static-libgcc", "-Wl,--fatal-warnings",
         "-Wl,-Map=epub-v2h-ada.map") & Platform.Native_Libraries;
   end Linker;
end Epub_V2h_Ada;
