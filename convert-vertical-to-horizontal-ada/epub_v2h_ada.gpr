with "xmlada_sax";
with "zipada";
with "core_containers.gpr";

project Epub_V2h_Ada is
   for Languages use ("Ada");
   for Source_Dirs use ("src");
   for Excluded_Source_Files use ("epub.ads", "epub-lists.ads", "epub-lists.adb");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("epub_v2h_main.adb");
   package Builder is
      for Executable ("epub_v2h_main.adb") use "epub-v2h-ada";
   end Builder;
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatw.e", "-gnatwe", "-gnata",
         "-Wall", "-Wextra", "-Werror", "-g", "-O2");
   end Compiler;
   package Binder is
      for Default_Switches ("Ada") use ("-static", "-we");
   end Binder;
   package Linker is
      for Default_Switches ("Ada") use
        ("-static", "-static-libgcc", "-lshell32", "-Wl,--fatal-warnings",
         "-Wl,-Map=epub-v2h-ada.map");
   end Linker;
end Epub_V2h_Ada;
