with "platform.gpr";
with "build_options.gpr";
project Core_Containers is
   for Languages use ("Ada");
   for Source_Dirs use ("src");
   for Source_Files use ("epub.ads", "epub-lists.ads", "epub-lists.adb");
   for Object_Dir use "obj/containers" & Platform.Build_Suffix;
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatw.e", "-gnatwe", "-gnata", "-Wall", "-Wextra", "-Werror", "-g") &
        Build_Options.Optimization & Build_Options.Instrumentation;
   end Compiler;
end Core_Containers;
