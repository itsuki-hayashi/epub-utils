with "aunit";
with "json_dependency.gpr";
with "native_options.gpr";

project Tests extends "../epub_v2h_ada.gpr" is
   for Languages use ("Ada", "C");
   for Source_Dirs use ("../src", "src");
   for Excluded_Source_Files use ("epub.ads", "epub-lists.ads", "epub-lists.adb");
   for Object_Dir use "../obj/tests";
   for Exec_Dir use "../bin/tests";
   for Main use ("test_runner.adb");
   package Builder is
      for Executable ("test_runner.adb") use "test-runner";
   end Builder;
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatw.e", "-gnatwe", "-gnata", "-Wall", "-Wextra", "-Werror", "-g", "-O2");
      for Default_Switches ("C") use Native_Options.C_Options;
   end Compiler;
   package Linker is
      for Default_Switches ("Ada") use
        ("-static", "-static-libgcc", "-lshell32", "-Wl,--fatal-warnings") & Native_Options.Wrap_Options;
   end Linker;
end Tests;
