with "aunit";
with "json_dependency.gpr";
with "native_options.gpr";
with "../platform.gpr";

project Tests extends "../epub_v2h_ada.gpr" is
   for Languages use ("Ada", "C");
   for Source_Dirs use ("../src", "../src/platform/" & Platform.Target, "src");
   for Excluded_Source_Files use ("epub.ads", "epub-lists.ads", "epub-lists.adb");
   for Object_Dir use "../obj/tests" & Platform.Build_Suffix;
   for Exec_Dir use "../bin/tests" & Platform.Build_Suffix;
   case Platform.Target is
      when "linux" =>
         for Main use ("linux_runner.adb");
         for Excluded_Source_Files use
           ("epub.ads", "epub-lists.ads", "epub-lists.adb", "test_runner.adb",
            "windows_cases.ads", "windows_cases.adb", "fault_cases.ads", "fault_cases.adb",
            "native_faults.ads", "native_faults.adb", "native_failures.c");
      when others =>
         for Main use ("test_runner.adb");
         for Excluded_Source_Files use
           ("epub.ads", "epub-lists.ads", "epub-lists.adb", "linux_runner.adb");
   end case;
   package Builder is
      for Executable ("test_runner.adb") use "test-runner";
      for Executable ("linux_runner.adb") use "test-runner";
   end Builder;
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatw.e", "-gnatwe", "-gnata", "-Wall", "-Wextra", "-Werror", "-g", "-O2");
      case Platform.Target is
         when "linux" =>
            for Default_Switches ("C") use
              ("-std=c17", "-Wall", "-Wextra", "-Werror", "-g", "-O2");
         when others =>
            for Default_Switches ("C") use Native_Options.C_Options;
      end case;
   end Compiler;
   package Linker is
      case Platform.Target is
         when "linux" =>
            for Default_Switches ("Ada") use
              ("-static", "-static-libgcc", "-Wl,--fatal-warnings");
         when others =>
            for Default_Switches ("Ada") use
              ("-static", "-static-libgcc", "-lshell32", "-Wl,--fatal-warnings") & Native_Options.Wrap_Options;
      end case;
   end Linker;
end Tests;
