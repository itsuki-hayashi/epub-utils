with "../../epub_v2h_ada.gpr";
project Summary is
   for Source_Dirs use ("src");
   for Source_Files use ("summary_main.adb", "oracle_io.ads", "oracle_io.adb");
   for Object_Dir use "obj/summary";
   for Exec_Dir use "bin";
   for Main use ("summary_main.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnatw.e", "-gnatwe", "-gnata", "-O2");
   end Compiler;
   package Binder is
      for Default_Switches ("Ada") use ("-static");
   end Binder;
   package Linker is
      for Default_Switches ("Ada") use ("-static", "-static-libgcc");
   end Linker;
end Summary;
