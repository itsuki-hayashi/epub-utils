with "xmlada_sax";
with "../../core_containers.gpr";
project Oracle is
   for Source_Dirs use ("src", "../../src", "../../src/profiling/off");
   for Source_Files use ("oracle_main.adb", "oracle_io.ads", "oracle_io.adb",
     "oracle_xml.ads", "oracle_xml.adb", "epub-performance.ads", "epub-performance.adb");
   for Object_Dir use "obj/original";
   for Exec_Dir use "bin";
   for Main use ("oracle_main.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnatw.e", "-gnatwe", "-gnata", "-O2");
   end Compiler;
   package Binder is
      for Default_Switches ("Ada") use ("-static");
   end Binder;
   package Linker is
      for Default_Switches ("Ada") use ("-static", "-static-libgcc");
   end Linker;
end Oracle;
