with "zipada";
with "../platform.gpr";

--  Unmodified third-party generic instantiations use upstream diagnostics.
project Codec_Reference is
   for Languages use ("Ada");
   for Source_Dirs use ("references");
   for Object_Dir use "../obj/codec-reference" & Platform.Build_Suffix;
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-g", "-O2");
   end Compiler;
end Codec_Reference;
